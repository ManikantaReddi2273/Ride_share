# Copy to .env.local for local Vite, or set in Vercel Project → Settings → Environment Variables

# After Oracle VM is up, use your public IP or domain (nginx on port 80):
VITE_API_BASE_URL=http://YOUR_ORACLE_VM_PUBLIC_IP/api
VITE_WS_URL=http://YOUR_ORACLE_VM_PUBLIC_IP/ws

# After HTTPS (optional later):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_WS_URL=https://api.yourdomain.com/ws

VITE_STORAGE_SECRET=change-me-to-a-random-string
