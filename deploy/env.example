# ============================================================
# Copy this file to the project root as `.env` on the Oracle VM
#   cp deploy/env.example .env
# Then fill in Neon / secrets / your Vercel URL
# ============================================================

# ---------- Neon PostgreSQL ----------
# From Neon dashboard: Connection string
# Host looks like: ep-xxxxx.region.aws.neon.tech
# Create THREE databases in Neon: user_db, ride_db, payment_db
NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=REPLACE_WITH_NEON_PASSWORD

# Include sslmode=require for Neon
USER_DB_URL=jdbc:postgresql://ep-XXXX.region.aws.neon.tech/user_db?sslmode=require
RIDE_DB_URL=jdbc:postgresql://ep-XXXX.region.aws.neon.tech/ride_db?sslmode=require
PAYMENT_DB_URL=jdbc:postgresql://ep-XXXX.region.aws.neon.tech/payment_db?sslmode=require

# ---------- Security ----------
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ---------- CORS / Frontend (Vercel URL after deploy) ----------
# Example: https://ride-share-xxxx.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_APP.vercel.app,http://localhost:5173

# ---------- Email (Gmail App Password) ----------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# ---------- OpenRouteService ----------
GOOGLE_MAPS_API_KEY=your-openrouteservice-api-key

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_MODE=TEST
