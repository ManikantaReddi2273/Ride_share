# ============================================================
# Railway + Neon + Vercel — copy values into Railway Variables
# DO NOT commit real passwords to git
# ============================================================

# From your Neon connection string:
# postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#
# Host:   ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech
# User:   neondb_owner
# Create databases in Neon: user_db, ride_db, payment_db

NEON_HOST=ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech
NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=REPLACE_WITH_YOUR_NEON_PASSWORD

USER_DB_URL=jdbc:postgresql://ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech/user_db?sslmode=require
RIDE_DB_URL=jdbc:postgresql://ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech/ride_db?sslmode=require
PAYMENT_DB_URL=jdbc:postgresql://ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech/payment_db?sslmode=require

# Shared
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32CHARS_MIN
POSTGRES_AUTO_CREATE=false

# Set AFTER Vercel deploy (your real frontend URL)
CORS_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app,http://localhost:5173

# Mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# Maps + Razorpay
GOOGLE_MAPS_API_KEY=your-openrouteservice-key
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_MODE=TEST

# Eureka (Railway private networking — service names must match Railway service names)
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
