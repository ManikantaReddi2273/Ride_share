# Fill these in the Render dashboard (do not commit real passwords)

# Neon
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD

# Per service URL:
# user-service:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech/user_db?sslmode=require
# ride-service:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech/ride_db?sslmode=require
# payment-service:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-weathered-cloud-axhpd4hu.c-4.us-east-2.aws.neon.tech/payment_db?sslmode=require

# After Eureka is live:
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=https://eureka-server-XXXX.onrender.com/eureka/

JWT_SECRET=change-me-long-random
CORS_ALLOWED_ORIGINS=https://YOUR_APP.vercel.app,http://localhost:5173

# api-gateway-service — direct upstreams (recommended on Render free)
# GATEWAY_USER_SERVICE_URI=https://user-service-XXXX.onrender.com
# GATEWAY_RIDE_SERVICE_URI=https://ride-service-XXXX.onrender.com
# GATEWAY_PAYMENT_SERVICE_URI=https://payment-service-XXXX.onrender.com

RESEND_API_KEY=
# Optional after you verify a domain on Resend:
# RESEND_FROM=Smart Ride Sharing <noreply@yourdomain.com>
OTP_REVEAL_ON_MAIL_FAILURE=true

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=TEST
