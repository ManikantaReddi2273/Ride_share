# ============================================
# RIDE_SHARING - Root .gitignore (deploy-ready)
# ============================================

# --------------------------------------------
# Secrets & local environment (DO NOT COMMIT)
# --------------------------------------------
.env
.env.*
!.env.example
*.env
!.env.example

# Local Spring Boot overrides (put secrets here, not in application.properties)
**/application-local.properties
**/application-local.yml
**/application-local.yaml
**/application-secret.properties
**/application-prod-local.properties
**/bootstrap-local.properties

# Credentials / certificates / keystores
*.pem
*.p12
*.jks
*.keystore
credentials.json
secrets.json
**/secrets/
**/credentials/

# --------------------------------------------
# Java / Maven / Spring Boot
# --------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
!**/maven-wrapper.jar
*.log
*.log.*
hs_err_pid*
replay_pid*

target/
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar.bak

# Spring Boot
spring-boot-devtools.properties

# --------------------------------------------
# Frontend (React / Vite / Node)
# --------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

dist/
dist-ssr/
build/
**/dist/
.vite/
vite.config.js.timestamp-*
*.local

# Frontend env (Vite)
fronted_ride_share/.env
fronted_ride_share/.env.*
!fronted_ride_share/.env.example

# --------------------------------------------
# IDE / Editors
# --------------------------------------------
.idea/
**/.idea/
*.iws
*.iml
*.ipr
out/

.vscode/
**/.vscode/
!.vscode/extensions.json
*.code-workspace

.classpath
.project
.settings/
**/.settings/
.metadata/
**/.metadata/
bin/
.apt_generated
.factorypath
.springBeans
.sts4-cache
.recommenders/
.loadpath

# NetBeans
**/nbproject/private/
**/nbbuild/
**/nbdist/
.nb-gradle/

# Cursor
.cursor/
.cursorignore

# --------------------------------------------
# OS
# --------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~

# --------------------------------------------
# Logs / temp / cache
# --------------------------------------------
logs/
**/logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~.nib
.cache/
**/.cache/
.parcel-cache/
tmp/
temp/

# --------------------------------------------
# Test / coverage
# --------------------------------------------
coverage/
.nyc_output/
*.lcov
htmlcov/
.pytest_cache/
test-output/
surefire-reports/
failsafe-reports/

# --------------------------------------------
# Databases (local dumps / sqlite)
# --------------------------------------------
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak

# --------------------------------------------
# Docker / deploy local overrides
# --------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml
.docker/

# --------------------------------------------
# Archives / media (accidental adds)
# --------------------------------------------
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --------------------------------------------
# Project-specific (not part of the app)
# --------------------------------------------
# Cursor / IDE screenshot dumps
assets/

# Local notes
Development.txt
*.local.md
